    "metadata": {
      "title": "ライフスポイラー - あなたの人生シナリオを先に確認",
      "description": "四柱推命より精密な紫微斗数。114個の星が描くあなただけの運命地図を確認してください。"
    },
    "landing": {
      "header": {
        "logoAlt": "ライフスポイラー ロゴ",
        "menuAriaLabel": "メニュー"
      },
      "hero": {
        "imageAlt": "運命の星座",
        "title": "あなたの人生シナリオ",
        "titleSub": "先に確認してみませんか？",
        "subtitle": "四柱推命より精密な",
        "subtitleHighlight": "紫微斗数"
