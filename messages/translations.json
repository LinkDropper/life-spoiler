      "cta": {
        "button": "人生のネタバレを確認する"
      },
      "features": {
        "feature1": {
          "title": "114個の星が描くディテール",
          "description": "単なる星座ではありません。あなたが生まれた瞬間、宇宙に存在した114個の星々の精密な座標を分析し、あなただけの固有な運命地図を描きます。",
          "imageAlt": "星座イメージ"
        },
        "feature2": {
