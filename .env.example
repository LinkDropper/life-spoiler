# 서버 환경변수
NODE_ENV=development

# 클라이언트 환경변수 (브라우저에서 접근 가능)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Key (서버 전용 - 절대 클라이언트에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 토스페이먼츠
NEXT_PUBLIC_TOSS_CLIENT_KEY=your-toss-client-key
TOSS_SECRET_KEY=your-toss-secret-key

# 앱
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI - Gemini (인생스포 텍스트 해석 롤백용)
GEMINI_API_KEY=your-gemini-api-key

# AI - OpenAI (인생스포 텍스트 해석 기본 제공자 + face-spoiler 공용)
OPENAI_API_KEY=your-openai-api-key
OPENAI_FACE_MODEL=gpt-5.4-mini-2026-03-17

# 인생스포 텍스트 해석 LLM 제공자: openai(default) 또는 gemini
LIFE_SPOILER_LLM_PROVIDER=openai

# 토스페이먼츠 PayPal (해외 간편결제 MID)
NEXT_PUBLIC_TOSS_PAYPAL_CLIENT_KEY=live_gck_...
TOSS_PAYPAL_SECRET_KEY=live_gsk_...

# Kakao JavaScript SDK (공유하기 기능)
NEXT_PUBLIC_KAKAO_JS_KEY=your-kakao-js-key

# 친구 우주 궁합 — IP 해시용 서버 시크릿 (HMAC 키)
# rate limit 판정 전용. IP 원문은 저장하지 않는다.
# 미설정 시 rate limit이 비활성화되므로 프로덕션에서는 반드시 설정할 것.
# 생성 예: openssl rand -hex 32
UNIVERSE_IP_HASH_SECRET=your-random-32-byte-hex-secret
