# 서버 환경변수
NODE_ENV=development

# 클라이언트 환경변수 (브라우저에서 접근 가능)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Key (서버 전용 - 절대 클라이언트에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 토스페이먼츠
NEXT_PUBLIC_TOSS_CLIENT_KEY=your-toss-client-key
TOSS_SECRET_KEY=your-toss-secret-key

# 앱
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI - Gemini (gemini-1.5-flash)
GEMINI_API_KEY=your-gemini-api-key

# 토스페이먼츠 PayPal (해외 간편결제 MID)
NEXT_PUBLIC_TOSS_PAYPAL_CLIENT_KEY=live_gck_...
TOSS_PAYPAL_SECRET_KEY=live_gsk_...

# Kakao JavaScript SDK (공유하기 기능)
NEXT_PUBLIC_KAKAO_JS_KEY=your-kakao-js-key